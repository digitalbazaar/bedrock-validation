{
  "name": "bedrock-validation-test",
  "version": "0.0.1-0",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "node --preserve-symlinks test.js test",
    "coverage": "cross-env NODE_ENV=test c8 --reporter=lcov --reporter=text-summary npm test",
    "coverage-ci": "cross-env NODE_ENV=test c8 --reporter=lcovonly npm test",
    "coverage-report": "c8 report"
  },
  "dependencies": {
    "@bedrock/core": "^6.3.0",
    "@bedrock/test": "^10.0.0",
    "@bedrock/validation": "file:..",
    "c8": "^12.0.0",
    "cross-env": "^10.1.0"
  },
  "c8": {
    "excludeNodeModules": false,
    "include": [
      "node_modules/@bedrock/validation/**"
    ],
    "exclude": [
      "node_modules/@bedrock/validation/node_modules/**"
    ]
  }
}
